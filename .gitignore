node_modules
dist
out
coverage
playwright-report
test-results
.DS_Store
.eslintcache
*.log*
*.tsbuildinfo

# Local-only working notes / review artifacts (kept on disk, not tracked)
memories/

# Superpowers specs & plans — local-only working notes (kept on disk, not tracked)
docs/superpowers/

# Roadmap & idea inbox — local-only working notes (kept on disk, not tracked).
# No trailing slash: `roadmap` is a symlink to the Obsidian vault (capy/), and a
# `roadmap/` pattern would only match a real dir, leaving the symlink tracked.
roadmap

# Scratch / probe scripts — throwaway CDP/e2e probes (underscore-prefixed convention)
scripts/_*

# Claude Code local config (generated per-machine). Everything under .claude/ is
# per-machine EXCEPT `.claude/skills/` — repo skills are version-controlled and
# shared (see `.claude/skills/harnu-awareness/`, T81).
.claude/*
!.claude/skills/

# Playwright MCP browser cache / console + page dumps (local, per-machine)
.playwright-mcp/

# One-off UI screenshots / probe captures (kept on disk, not tracked)
capy-logo-shot.png

# /dtk:mockup-qa working captures (screenshots, computed-style JSON, diffs) —
# ephemeral verification output; curated evidence gets copied into the
# relevant docs/specs/<slug>/evidence/ folder and committed from there.
mockup-qa/

# Harnu Project Memory (T79 S0) — local by default; opt-in commit is left for S1 (PRD §3.1 / open-q4)
# Per-repo data dir, old and new name; the slashless forms also ignore a symlink or file of that name.
.capy/
.harnu/
.capy
.harnu

# Per-machine WORKTREE.md overlay (deep-merged over the committed manifest at
# resolve time) — never commit machine-specific paths/PATH fixes.
WORKTREE.local.md

.superpowers/

# Generated by scripts/dev/t164-highlight-demo.mjs on demand (see ADR 0011); not committed.
docs/dev/t164-highlight-demo.html
