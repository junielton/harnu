{
  "name": "proactive-none",
  "order": 6,
  "title": "a one-line question creates no mission",
  "label": "v4 AC-80 (proactive, negative)",
  "description": "Missions v4 S-33, AC-80. The same framed session reads the same `mission` skill and gets a one-line question whose answer is in a file. It must answer it and create nothing: no v4 record, no v3 file, and no mission verb in its tool list. The harness records the turn into `.eval/turn-question.txt` (there is no mission to log into), and the grade reads that file, so a run that crashed or never answered does not pass vacuously: the answer (a codename that only the file holds) must be there.",
  "agents": ["A"],
  "phases": [
    {
      "copyIn": [
        {
          "from": "resources/skills/skills/mission/SKILL.md",
          "to": ".eval/mission/SKILL.md"
        },
        {
          "from": "resources/skills/skills/mission/references/writing-contract.md",
          "to": ".eval/mission/references/writing-contract.md"
        },
        {
          "from": "scripts/eval/mission-behavior/fixtures/codename.txt",
          "to": "docs/codename.txt"
        }
      ]
    },
    {
      "agent": "A",
      "role": "session",
      "tools": ["Read"],
      "record": {
        "tag": "question",
        "file": true
      },
      "prompt": "Skill file: .eval/mission/SKILL.md.\n\nThe operator asks, in one line: \"What is the codename in docs/codename.txt?\" Answer in one line."
    }
  ],
  "assert": [
    {
      "missionCount": 0
    },
    {
      "legacyMissionCount": 0
    },
    {
      "file": ".eval/turn-question.txt",
      "label": "the turn ran and left its record",
      "exists": true
    },
    {
      "file": ".eval/turn-question.txt",
      "label": "it answered the question",
      "contains": "Kestrel-7"
    },
    {
      "file": ".eval/turn-question.txt",
      "label": "it called no verb of Harnu: only reads",
      "matches": "^tools=(Read(,Read)*)?$",
      "flags": "m"
    }
  ],
  "breaks": [
    {
      "name": "created-a-mission",
      "mutate": [
        {
          "addMission": "question-mission"
        }
      ]
    },
    {
      "name": "a-v3-mission-appeared",
      "mutate": [
        {
          "addV3Mission": "mnt-0badc0de-old.md"
        }
      ]
    },
    {
      "name": "called-mission-create",
      "mutate": [
        {
          "file": ".eval/turn-question.txt",
          "write": "tools=Read,mission_create\nasked=false\n---\nKestrel-7\n"
        }
      ]
    },
    {
      "name": "called-mission-list",
      "mutate": [
        {
          "file": ".eval/turn-question.txt",
          "write": "tools=Read,mission_list\nasked=false\n---\nKestrel-7\n"
        }
      ]
    },
    {
      "name": "never-answered",
      "mutate": [
        {
          "file": ".eval/turn-question.txt",
          "write": "tools=Read\nasked=false\n---\nI do not know.\n"
        }
      ]
    },
    {
      "name": "the-run-crashed",
      "mutate": [
        {
          "file": ".eval/turn-question.txt",
          "write": "tools=\nasked=false\n---\n(no result event)\n"
        }
      ]
    },
    {
      "name": "no-record",
      "mutate": [
        {
          "file": ".eval/turn-question.txt",
          "delete": true
        }
      ]
    },
    {
      "name": "turn-file-not-loaded",
      "mutate": [
        {
          "file": ".eval/turn-question.txt",
          "unload": true
        }
      ]
    }
  ]
}
