diff --git a/sqlite_utils/utils.py b/sqlite_utils/utils.py
--- a/sqlite_utils/utils.py
+++ b/sqlite_utils/utils.py
@@ -285,6 +285,34 @@ def _extra_key_strategy(
             yield row_out
 
 
+def extract_json_records(decoded, key=None, auto_key=False):
+    """Apply key= / auto_key= to decoded JSON, returning a list or a dict."""
+    if key is not None:
+        if not isinstance(decoded, dict):
+            raise RowsFromFileBadJSON("key= needs a JSON object at the top level")
+        if key not in decoded:
+            raise RowsFromFileBadJSON(f"Key '{key}' not found in JSON object")
+        value = decoded[key]
+        if not isinstance(value, (list, dict)):
+            raise RowsFromFileBadJSON(f"Key '{key}' must hold a list or an object")
+        return value
+    if auto_key and isinstance(decoded, dict):
+        candidates = [
+            k
+            for k, v in decoded.items()
+            if isinstance(v, list) and v and all(isinstance(o, dict) for o in v)
+        ]
+        if not candidates:
+            raise RowsFromFileBadJSON("No top-level key holds a list of objects")
+        if len(candidates) > 1:
+            raise RowsFromFileBadJSON(
+                "Several top-level keys hold a list of objects: "
+                + ", ".join(candidates)
+            )
+        return decoded[candidates[0]]
+    return decoded
+
+
