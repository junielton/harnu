  @@ -285,6 +285,76 @@ def _extra_key_strategy(
  +def _json_type_name(value: object) -> str:
  +    # bool must be checked before int/float, because True is an int in Python
  +    if isinstance(value, bool):
  +        return "boolean"
  +    if isinstance(value, (int, float)):
  +        return "number"
  +    if isinstance(value, str):
  +        return "string"
  +    if value is None:
  +        return "null"
  +    if isinstance(value, list):
  +        return "list"
  +    if isinstance(value, dict):
  +        return "object"
  +    return type(value).__name__
  +
  +
  +def _extract_json_rows(
  +    decoded: object, key: str | None = None, auto_key: bool = False
  +) -> object:
  +    """
  +    Given a decoded JSON value, return the value to treat as rows.
  +
  +    With ``key=`` the value is read from that top-level key of a JSON object.
  +    With ``auto_key=True`` the single top-level key holding a non-empty list of
  +    objects is used; anything that is not a JSON object is returned unchanged.
  +
  +    Raises ``RowsFromFileBadJSON`` if the rows cannot be found.
  +    """
  +    if key is not None:
  +        if not isinstance(decoded, dict):
  +            raise RowsFromFileBadJSON(
  +                "Cannot use key {}: JSON is a {}, not an object".format(
  +                    repr(key), _json_type_name(decoded)
  +                )
  +            )
  +        if key not in decoded:
  +            raise RowsFromFileBadJSON(
  +                "Key {} not found in JSON object".format(repr(key))
  +            )
  +        value = decoded[key]
  +        if not isinstance(value, (list, dict)):
  +            raise RowsFromFileBadJSON(
  +                "Key {} must contain a list or an object, got {}".format(
  +                    repr(key), _json_type_name(value)
  +                )
  +            )
  +        return value
  +    if auto_key:
  +        if not isinstance(decoded, dict):
  +            return decoded
  +        qualifying = [
  +            k
  +            for k, v in decoded.items()
  +            if isinstance(v, list) and v and all(isinstance(i, dict) for i in v)
  +        ]
  +        if not qualifying:
  +            raise RowsFromFileBadJSON(
  +                "No key in JSON object contains a list of objects"
  +            )
  +        if len(qualifying) > 1:
  +            raise RowsFromFileBadJSON(
  +                "Multiple keys contain a list of objects: {} - use --key to pick one".format(
  +                    ", ".join(repr(k) for k in qualifying)
  +                )
  +            )
  +        return decoded[qualifying[0]]
  +    return decoded
  +
