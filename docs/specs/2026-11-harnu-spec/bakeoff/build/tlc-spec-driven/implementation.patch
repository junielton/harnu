  +def _json_records(
  +    decoded: Any, key: str | None = None, auto_key: bool = False
  +) -> list[Any]:
  +    """
  +    Return the records held by a decoded JSON document.
  +
  +    With neither ``key`` nor ``auto_key`` a top-level object is a single record and a
  +    top-level list is a list of records. ``key`` reads the records from that top-level
  +    key of an object, ``auto_key`` from the one top-level key whose value is a non-empty
  +    list of objects.
  +
  +    Raises ``RowsFromFileBadJSON`` if the document does not have that shape.
  +    """
  +    if key is not None and auto_key:
  +        raise ValueError("Cannot use key= and auto_key= together")
  +    if key is not None:
  +        if not isinstance(decoded, dict):
  +            raise RowsFromFileBadJSON(
  +                f'Cannot read key "{key}": the top-level JSON value is not an object'
  +            )
  +        if key not in decoded:
  +            raise RowsFromFileBadJSON(
  +                f'Key "{key}" not found in the top-level JSON object'
  +            )
  +        decoded = decoded[key]
  +        if isinstance(decoded, dict):
  +            return [decoded]
  +        if not isinstance(decoded, list):
  +            raise RowsFromFileBadJSON(f'Key "{key}" does not hold a list or an object')
  +        return decoded
  +    if auto_key and isinstance(decoded, dict):
  +        candidates = [
  +            name
  +            for name, value in decoded.items()
  +            if isinstance(value, list)
  +            and value
  +            and all(isinstance(item, dict) for item in value)
  +        ]
  +        if not candidates:
  +            raise RowsFromFileBadJSON(
  +                "No top-level key holds a non-empty list of objects"
  +            )
  +        if len(candidates) > 1:
  +            raise RowsFromFileBadJSON(
  +                "Multiple top-level keys hold a non-empty list of objects: {}".format(
  +                    ", ".join(f'"{name}"' for name in candidates)
  +                )
  +            )
  +        return decoded[candidates[0]]
  +    if isinstance(decoded, dict):
  +        return [decoded]
  +    if not isinstance(decoded, list):
  +        raise RowsFromFileBadJSON("JSON must be a list or a dictionary")
  +    return decoded
  +
