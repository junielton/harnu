  @@ -285,6 +285,74 @@ def _extra_key_strategy(
  +def _is_list_of_objects(value: object) -> bool:
  +    return (
  +        isinstance(value, list)
  +        and len(value) > 0
  +        and all(isinstance(item, dict) for item in value)
  +    )
  +
  +
  +def _rows_for_json_key(
  +    data: object, key: str | None = None, auto_key: bool = False
  +) -> list:
  +    """
  +    Turn an already-decoded JSON value into a list of rows.
  +
  +    With neither ``key`` nor ``auto_key`` a top-level object becomes a single row
  +    and a top-level list is returned unchanged. ``key`` names a top-level key whose
  +    value holds the rows; ``auto_key=True`` uses the one top-level key whose value
  +    is a non-empty list of objects.
  +    """
  +    if key is not None:
  +        if isinstance(data, list):
  +            raise RowsFromFileBadJSON(
  +                "Cannot use key {!r}: the JSON top level is a list, not an object".format(
  +                    key
  +                )
  +            )
  +        if not isinstance(data, dict):
  +            raise RowsFromFileBadJSON(
  +                "Cannot use key {!r}: the JSON top level must be an object".format(key)
  +            )
  +        if key not in data:
  +            raise RowsFromFileBadJSON(
  +                "Key {!r} was not found in the top-level JSON object".format(key)
  +            )
  +        value = data[key]
  +        if isinstance(value, list):
  +            return value
  +        if isinstance(value, dict):
  +            return [value]
  +        raise RowsFromFileBadJSON(
  +            "Key {!r} must hold a list or an object, got {}".format(
  +                key, json.dumps(value)
  +            )
  +        )
  +    if auto_key:
  +        if isinstance(data, list):
  +            return data
  +        if not isinstance(data, dict):
  +            raise RowsFromFileBadJSON(
  +                "auto_key requires the JSON top level to be an object or a list"
  +            )
  +        candidates = [k for k, v in data.items() if _is_list_of_objects(v)]
  +        if not candidates:
  +            raise RowsFromFileBadJSON("No top-level key holds a list of objects")
  +        if len(candidates) > 1:
  +            raise RowsFromFileBadJSON(
  +                "More than one top-level key holds a list of objects: {}".format(
  +                    ", ".join(candidates)
  +                )
  +            )
  +        return data[candidates[0]]
  +    if isinstance(data, dict):
  +        return [data]
  +    if not isinstance(data, list):
  +        raise RowsFromFileBadJSON("JSON must be a list or a dictionary")
  +    return data
  +
